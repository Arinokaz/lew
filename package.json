{
  "name": "lew",
  "version": "1.0.0",
  "private": true,
  "description": "Learn English Words - Oxford 5000 PWA with SM-2 spaced repetition",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/",
    "coverage": "c8 --reporter=text --reporter=html node --test tests/",
    "serve": "npx serve docs/",
    "serve:docs": "python3 -m http.server 8000 --directory docs",
    "dev": "node tools/serve.mjs",
    "dev:py": "python3 -m http.server 8000 --directory docs",
    "build": "node tools/build.mjs",
    "preview": "npx serve dist/",
    "vendor:dexie": "bash tools/vendor-dexie.sh"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jsdom": "^30.0.1"
  }
}
